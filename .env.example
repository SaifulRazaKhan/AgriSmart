# Twilio Account Credentials for Real SMS OTP Dispatches
# Replace these values with your actual Twilio API credentials.
# Save this file as '.env' in the same folder as server.js.

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_sender_phone_number_here
